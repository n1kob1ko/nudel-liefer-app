// Core v1 schema (backlog §6). AuditLog is added by NUD-092.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DRIVER
}

/// Mapped to BCP-47 tags in the database; see src/lib/localized-text.ts.
enum Locale {
  de
  en
  sr_Latn @map("sr-Latn")
  cs
  zh_Hans @map("zh-Hans")
}

enum Unit {
  KG
  PACK
  CRATE
  PIECE
}

enum PhotoKind {
  STORE
  PARKING
}

enum OrderSource {
  MANUAL
  SCREENSHOT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// How the customer pays one order (D33, NUD-196). `MONTHLY` = on the accumulated monthly bill,
/// `ON_DELIVERY` = cash at the stop (the driver records what he collected).
enum PaymentTerm {
  MONTHLY
  ON_DELIVERY
}

enum TourStatus {
  DRAFT
  OPTIMIZED
  RELEASED
  IN_PROGRESS
  COMPLETED
}

/// What a re-release did to a stop (NUD-043): shown to the driver as a highlight.
enum StopChange {
  ADDED
  CHANGED
}

enum StopStatus {
  PENDING
  DELIVERED
  PROBLEM
}

enum ProblemReason {
  CLOSED
  NOBODY_THERE
  NO_PARKING
  WRONG_QUANTITY
  REFUSED
  ADDRESS_NOT_FOUND
  OTHER
}

model User {
  id           String    @id @default(cuid())
  role         Role
  email        String?   @unique
  username     String?   @unique
  passwordHash String
  locale       Locale    @default(de)
  localeChosen Boolean   @default(false)
  displayName  String
  active       Boolean   @default(true)
  /// Set on every successful login (NUD-008).
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  photos      Photo[]
  screenshots Screenshot[]
  orders      Order[]
  tours       Tour[]

  parkingSpots        ParkingSpot[]
  keyUpdates          Customer[]       @relation("CustomerKeyUpdatedBy")
  abbreviationUpdates Customer[]       @relation("CustomerAbbreviationUpdatedBy")
  recurringOrders     RecurringOrder[]
  /// Working days and hours (NUD-152); one row per ISO weekday, `active = false` = not working.
  workSchedules       WorkSchedule[]
  /// Default driver of a standing tour ("Stammtour"): the driver who knows these customers.
  standingTours       StandingTour[]
  /// Cash the driver collected (D33, NUD-196).
  collectedStops      Stop[]           @relation("StopCollectedBy")
  /// Monthly bills the user marked as paid (D33, NUD-196).
  monthlyPaymentsPaid MonthlyPayment[] @relation("MonthlyPaymentPaidBy")
}

/// A driver's working day (NUD-152): one row per ISO weekday (1 = Monday ... 7 = Sunday). A weekday
/// without a row, or with `active = false`, is a non-working day. Soft delete only (`active`); the
/// hours are minutes since midnight in the factory time zone, `startMinutes < endMinutes`.
model WorkSchedule {
  id           String   @id @default(cuid())
  driverId     String
  weekday      Int
  startMinutes Int
  endMinutes   Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  driver User @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@unique([driverId, weekday])
  @@index([driverId])
}

/// Singleton row (id = 1).
model Settings {
  id                    Int     @id @default(1)
  depotName             String
  depotAddress          String
  depotLat              Float
  depotLng              Float
  /// True once an admin has confirmed the depot pin on the map (D9). Tour building requires it.
  depotPinConfirmed     Boolean @default(false)
  timezone              String  @default("Europe/Vienna")
  departureTime         String  @default("07:00")
  serviceMinutesPerStop Int     @default(10)
  deliveryWeekdays      Int[]   @default([1, 2, 3, 4, 5])
  /// How many days ahead the daily job generates orders from recurring rules (NUD-149, D25).
  recurringLeadDays     Int     @default(14)
  /// Fixed items of the driver's departure checklist (NUD-151), e.g. "Lieferscheine": a JSON array of
  /// `{ id, text: LocalizedText }` in display order. Empty = only the computed lines (products, keys).
  departureChecklist    Json    @default("[]")
  /// Loading time assumed when the driver skipped the departure checklist (NUD-152, D28): the
  /// measured working time starts `defaultLoadingMinutes` before `Tour.departedAt`.
  defaultLoadingMinutes Int     @default(20)
}

model Customer {
  id                      String    @id @default(cuid())
  customerNumber          String    @unique
  name                    String
  street                  String
  postalCode              String
  city                    String
  country                 String    @default("AT")
  lat                     Float?
  lng                     Float?
  /// Unused since NUD-141 (D22: no pin confirmation); kept so no destructive migration is needed.
  pinConfirmed            Boolean   @default(false)
  /// LocalizedText
  notes                   Json?
  deliveryHoursInfo       String?
  /// Legal entity behind the shop ("Firma"), office only. The driver matches `name` to the signage.
  companyName             String?
  /// VAT identification number ("UID", e.g. ATU12345678), office only.
  vatId                   String?
  /// Billing address, only when it differs from the delivery address above (office only, never routed).
  billingStreet           String?
  billingPostalCode       String?
  billingCity             String?
  /// Key to the shop (NUD-142, D27): `null` = unknown, `true` = the factory holds a key, `false` = none.
  /// Office and drivers maintain it; every change is audited (`customer.key`).
  hasKey                  Boolean?
  /// Number on the key tag, max 20 characters; only set while `hasKey` is true.
  keyNumber               String?
  keyUpdatedById          String?
  keyUpdatedAt            DateTime?
  /// Legacy internal code from the old system (NUD-164, D27). Free text with special characters, optional,
  /// NOT unique, no logic; shown to drivers only to find their way until the new system is adopted, then removed.
  abbreviation            String?
  abbreviationUpdatedById String?
  abbreviationUpdatedAt   DateTime?
  active                  Boolean   @default(true)
  /// Accent-folded number/name/address for search. Maintained by a DB trigger (migration NUD-013); never write it.
  searchText              String    @default("")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  photos                Photo[]
  orders                Order[]
  stops                 Stop[]
  parkingSpots          ParkingSpot[]
  recurringOrders       RecurringOrder[]
  keyUpdatedBy          User?            @relation("CustomerKeyUpdatedBy", fields: [keyUpdatedById], references: [id], onDelete: Restrict)
  abbreviationUpdatedBy User?            @relation("CustomerAbbreviationUpdatedBy", fields: [abbreviationUpdatedById], references: [id], onDelete: Restrict)
  standingTours         StandingTourCustomer[]
  /// Paid monthly bills of the customer (D33, NUD-196).
  monthlyPayments       MonthlyPayment[]

  @@index([name])
}

/// The office's "this month is paid" note for one customer (D33, NUD-196). One row per customer and
/// month: marking it paid again updates the row (`voidedAt` cleared), un-marking sets `voidedAt`.
/// `amountCents` and `orderCount` are a snapshot of what was marked, because orders can be edited
/// afterwards; the live total of the month is computed from the orders every time.
model MonthlyPayment {
  id          String   @id @default(cuid())
  customerId  String
  /// First day of the billed month, factory time zone (`DATE`).
  periodStart DateTime @db.Date
  amountCents Int
  orderCount  Int
  /// Optional note of the office ("bar beglichen", "Überweisung 3 Tage später", ...).
  note        String?
  paidAt      DateTime @default(now())
  paidById    String
  /// Set when the office takes the "paid" note back; the row stays (history, audit).
  voidedAt    DateTime?
  voidedById  String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paidBy   User     @relation("MonthlyPaymentPaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  @@unique([customerId, periodStart])
  @@index([periodStart])
  @@index([customerId, periodStart])
}

/// A standing delivery group ("Stammtour", NUD-186): the same customers every delivery day, in a
/// fixed order, with one driver who knows them (changeable when he is ill or replaced). The group
/// decides which customers the day plan (`/admin/planning`) lists for the office — it is NOT a
/// `Tour`: tours are still built per delivery day by "Touren planen". Soft delete only (`active`).
model StandingTour {
  id        String   @id @default(cuid())
  name      String
  /// Default driver of the group; `null` = not assigned. A day's tour driver is set in the tour.
  driverId  String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver    User?                 @relation(fields: [driverId], references: [id], onDelete: Restrict)
  customers StandingTourCustomer[]

  @@index([driverId])
}

/// Membership of one customer in one standing tour, in delivery order (`sortOrder`).
model StandingTourCustomer {
  standingTourId String
  customerId     String
  sortOrder      Int    @default(0)

  standingTour StandingTour @relation(fields: [standingTourId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@id([standingTourId, customerId])
  @@index([customerId])
}

/// Where the driver parks and unloads at a customer (NUD-125, D22). A customer has a list; the first
/// active one by `sortOrder` is the default and becomes the routing / navigation point (NUD-141).
/// Soft delete only (`active=false`).
model ParkingSpot {
  id          String   @id @default(cuid())
  customerId  String
  /// Short name shown to the office and the driver ("Hof", "Gasse hinten"); optional.
  label       String?
  /// Free text typed by the office or a driver (docs/privacy.md section 6); optional.
  note        String?
  lat         Float
  lng         Float
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, active, sortOrder])
}

model Photo {
  id               String    @id @default(cuid())
  customerId       String
  kind             PhotoKind
  storageKey       String
  width            Int
  height           Int
  bytes            Int
  uploadedById     String
  isCurrent        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  /// Client-generated id of a driver capture (NUD-083): a retry of the same capture finds this row
  /// instead of creating a second photo. `null` for photos added by the office.
  clientMutationId String?   @unique

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([customerId, kind, isCurrent])
}

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  /// LocalizedText
  name            Json
  unit            Unit
  /// Weight of one unit in kilograms (NUD-138): Sackerl 3, Kiste 10, Wantan-Teig 5. Admin-editable,
  /// always > 0 (CHECK constraint in the migration); the tour weight (NUD-146) is computed from it.
  weightKgPerUnit Decimal  @db.Decimal(6, 2)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems          OrderItem[]
  recurringOrderItems RecurringOrderItem[]
  recurringDayItems   RecurringOrderDayItem[]
}

model Screenshot {
  id           String   @id @default(cuid())
  storageKey   String
  uploadedById String
  createdAt    DateTime @default(now())
  /// Filled by AI extraction in M3.
  extraction   Json?

  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  orders     Order[]
}

model Order {
  id               String      @id @default(cuid())
  customerId       String
  /// PLANNED delivery day (NUD-148, D25): set by planning (earliest day in the window with capacity), movable by the office.
  deliveryDate     DateTime    @db.Date
  /// Requested delivery window (first and last day, factory time zone), `windowFrom <= windowTo`.
  windowFrom       DateTime    @db.Date
  windowTo         DateTime    @db.Date
  /// Optional time of day "HH:MM" (24 h) the window starts / ends at; applies to the planned day.
  windowFromTime   String?
  windowToTime     String?
  status           OrderStatus @default(DRAFT)
  source           OrderSource @default(MANUAL)
  screenshotId     String?
  internalNote     String?
  /// Pasted customer message the order was typed from (NUD-150, D26); store-only, never parsed again.
  sourceText       String?
  /// Raw answer of the AI extraction (NUD-150): what the model read, kept for review next to the order.
  aiExtraction     Json?
  /// Rule that generated this order (NUD-149) and the date it was generated for: one order per rule and date, also after it was cancelled.
  recurringOrderId String?
  recurringDate    DateTime?   @db.Date
  /// Cash at the stop or on the monthly bill (D33, NUD-196). Monthly is the default.
  paymentTerm      PaymentTerm @default(MONTHLY)
  /// Amount of this order in euro cents, typed by the office (there are no catalog prices, D33);
  /// `null` = no amount set yet. Whole cents, never a float.
  amountCents      Int?
  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  screenshot     Screenshot?     @relation(fields: [screenshotId], references: [id], onDelete: SetNull)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items          OrderItem[]
  stopOrders     StopOrder[]
  recurringOrder RecurringOrder? @relation(fields: [recurringOrderId], references: [id], onDelete: Restrict)

  @@unique([recurringOrderId, recurringDate])
  @@index([deliveryDate, status])
  @@index([customerId, deliveryDate])
  @@index([windowFrom, windowTo])
}

/// Standing order (Dauerbestellung, NUD-149, D25): the office confirms the rule once, a daily job generates
/// CONFIRMED orders `Settings.recurringLeadDays` ahead. Soft delete only (`active=false` = paused).
model RecurringOrder {
  id               String     @id @default(cuid())
  customerId       String
  /// ISO weekdays 1 (Monday) .. 7 (Sunday) the rule delivers on.
  weekdays         Int[]
  /// Every N-th week, counted from the week (Monday) of `anchorDate`.
  everyNWeeks      Int        @default(1)
  anchorDate       DateTime   @db.Date
  /// Season "MM-DD" .. "MM-DD" (both or none); from > to wraps over the year boundary.
  seasonFrom       String?
  seasonTo         String?
  /// Single days the rule skips.
  exceptions       DateTime[] @db.Date
  /// One connected skipped range (holiday/vacation), both or none (NUD-171). `skipFrom <= skipTo`.
  skipFrom         DateTime?  @db.Date
  skipTo           DateTime?  @db.Date
  /// Extra monthly patterns beside the weekly ones (NUD-171), a JSON array of
  /// `{"kind":"dayOfMonth","day":1..31}` or `{"kind":"nthWeekday","nth":1..4|-1,"weekday":1..7}`.
  /// The delivery days of the rule are the union of the weekly and the monthly patterns.
  monthlyRules     Json       @default("[]")
  /// Delivery window time "HH:MM" copied onto every generated order (NUD-171); both empty = all day.
  windowFromTime   String?
  windowToTime     String?
  /// End of the rule (NUD-171): a last delivery day and/or a maximum number of generated deliveries.
  /// Both empty = open-ended. `maxDeliveries` counts the orders the rule has created, cancelled ones
  /// included (they happened).
  endsOn           DateTime?  @db.Date
  maxDeliveries    Int?
  active           Boolean    @default(true)
  /// Paused because the customer was set inactive; reactivating the customer resumes exactly these rules.
  pausedByCustomer Boolean    @default(false)
  confirmedById    String
  confirmedAt      DateTime   @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  confirmedBy User                 @relation(fields: [confirmedById], references: [id], onDelete: Restrict)
  items       RecurringOrderItem[]
  /// Products that differ from the base `items` on one ISO weekday (NUD-171); no rows for a weekday
  /// means "same as the base list".
  dayItems    RecurringOrderDayItem[]
  orders      Order[]

  @@index([customerId, active])
}

/// A weekday-specific product list of a recurring order (NUD-171): the office can send 2 crates every
/// Monday and 1 bag every Thursday within the same rule.
model RecurringOrderDayItem {
  id               String @id @default(cuid())
  recurringOrderId String
  /// ISO weekday 1 (Monday) .. 7 (Sunday); CHECK in the migration.
  weekday          Int
  productId        String
  quantity         Int

  recurringOrder RecurringOrder @relation(fields: [recurringOrderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([recurringOrderId, weekday, productId])
  @@index([recurringOrderId, weekday])
  @@index([productId])
}

model RecurringOrderItem {
  id               String @id @default(cuid())
  recurringOrderId String
  productId        String
  quantity         Int

  recurringOrder RecurringOrder @relation(fields: [recurringOrderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([recurringOrderId])
  @@index([productId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  /// Whole number of units (D23, NUD-137): Sackerl, Kiste or pieces; never a fraction.
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

/// No unique constraint on date: several tours per date are allowed later (D5).
model Tour {
  id               String     @id @default(cuid())
  date             DateTime   @db.Date
  driverId         String?
  /// Vehicle of this tour (NUD-146, D24); driver and vehicle are assigned per tour per day.
  vehicleId        String?
  status           TourStatus @default(DRAFT)
  isOutdated       Boolean    @default(false)
  locked           Boolean    @default(false)
  depotSnapshot    Json
  geometry         Json?
  totalDistanceM   Int?
  totalDurationS   Int?
  /// True when the route came from the local heuristic (estimated distances, straight-line geometry).
  approximate      Boolean    @default(false)
  /// 0 = never released, 1 = first release, +1 for every re-release that changed something (NUD-043).
  releaseRevision  Int        @default(0)
  /// When the last re-release happened (null = never re-released); the driver app shows "Tour was updated".
  reReleasedAt     DateTime?
  /// What the last re-release changed (`TourDiff` plus `revision`, `at`, names for removed stops); null before.
  lastChange       Json?
  optimizedAt      DateTime?
  releasedAt       DateTime?
  completedAt      DateTime?
  /// The driver opened the departure checklist (NUD-151); first write wins. Null = never opened.
  loadingStartedAt DateTime?
  /// The driver tapped "Losfahren" or skipped the checklist (NUD-151); first write wins.
  departedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  driver  User?    @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  stops   Stop[]

  @@index([date])
  @@index([vehicleId])
}

/// A delivery vehicle with a load capacity in kg (NUD-146, D24). Soft delete only (`active`); a tour
/// keeps pointing at a deactivated vehicle.
model Vehicle {
  id         String   @id @default(cuid())
  name       String
  plate      String?
  /// Maximum load in kg (whole number, CHECK > 0 in the migration).
  capacityKg Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tours Tour[]
  stops Stop[]
}

model Stop {
  id                String         @id @default(cuid())
  tourId            String
  customerId        String
  sequence          Int
  /// Trip of the tour this stop belongs to (NUD-147): 1 = first trip; a higher number follows a reload at the depot
  /// or, when the next trip has another vehicle, a vehicle switch (NUD-158).
  trip              Int            @default(1)
  /// Vehicle of this stop's trip when it is not the tour's vehicle (NUD-158: the driver switches to another,
  /// already loaded vehicle at the depot). Null = `Tour.vehicleId`. All stops of one trip carry the same value.
  vehicleId         String?
  status            StopStatus     @default(PENDING)
  etaAt             DateTime?
  legDistanceM      Int?
  legDurationS      Int?
  problemReason     ProblemReason?
  /// LocalizedText (source = driver locale)
  problemNote       Json?
  completedAt       DateTime?
  clientMutationId  String?        @unique
  /// Quantities the office released for this stop, `[{productId, quantity}]` (NUD-043). The driver
  /// sees this snapshot, never the live order lines, so an order edited after release shows up only via re-release.
  items             Json           @default("[]")
  /// Quantities before the last re-release that changed this stop (null otherwise).
  previousItems     Json?
  changeKind        StopChange?
  /// `Tour.releaseRevision` in which `changeKind` was set; the driver highlights revisions it has not seen yet.
  changedInRevision Int?
  /// When the office last changed this stop's content (a re-release that changed or added it, NUD-082).
  /// The offline sync lets this win over a driver mutation that was made earlier on the phone.
  adminChangedAt    DateTime?

  /// Cash collected by the driver at this stop (D33, NUD-196): `collectedCents` null = not recorded,
  /// `collectedAt`/`collectedById` say when and by whom. Only ON_DELIVERY orders of the stop count.
  collectedCents    Int?
  collectedAt       DateTime?
  collectedById     String?

  tour        Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle     Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  collectedBy User?          @relation("StopCollectedBy", fields: [collectedById], references: [id], onDelete: Restrict)
  orders      StopOrder[]
  mutations   StopMutation[]

  @@index([tourId, sequence])
  @@index([customerId])
  @@index([vehicleId])
}

/// Driver stop-status mutation log (NUD-053): one row per accepted client mutation, keyed by the
/// client-generated id. A replay of the same id returns `result` without a second state change.
model StopMutation {
  id        String           @id
  stopId    String
  driverId  String
  kind      StopMutationKind
  result    Json
  createdAt DateTime         @default(now())

  stop Stop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([stopId])
}

enum StopMutationKind {
  COMPLETE
  UNDO
  /// Customer key number set by the driver at this stop (NUD-142); shares the idempotency table.
  KEY
  /// Customer Abkürzung set by the driver at this stop (NUD-164); shares the idempotency table.
  ABBREVIATION
  /// Parkplatz set by the driver at this stop (NUD-144).
  PARKING
  /// Driver opened the departure checklist of the stop's tour (NUD-151).
  LOADING
  /// Driver left the depot / skipped the checklist (NUD-151).
  DEPART
  /// Cash collected at the stop (D33, NUD-196); shares the idempotency table.
  PAYMENT
}

model StopOrder {
  stopId  String
  orderId String

  stop  Stop  @relation(fields: [stopId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([stopId, orderId])
  @@index([orderId])
}

/// Failed login attempts, used for rate limiting (NUD-004). Rows older than the window are pruned.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// "user:<admin|driver>:<identifier>" or "ip:<address>"
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Append-only history of changes to orders, tours, stops and customer photos (NUD-092). Rows are
/// written by `recordAudit` in the service layer, inside the transaction of the change itself,
/// and are never updated or deleted (the database refuses it, see the migration).
/// `entity` is "Order" | "Tour" | "Stop" | "Customer", `action` a dotted name such as
/// "order.update"; both are plain strings so a new action never needs a migration.
/// `diff` holds ids and values only (no names, no secrets); readers resolve names.
/// `actorId` is deliberately not a foreign key: users are archived, never deleted (backlog 4.3), and the
/// history must outlive whatever happens to the user row.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  entity    String
  entityId  String
  action    String
  diff      Json
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
}
